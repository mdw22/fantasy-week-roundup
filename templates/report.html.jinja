<title>{{ league.league_name }} — Week {{ report.week }} Report</title>
<style>{% include "styles.css" %}</style>

{% macro display_name(team_name) -%}
{{ (league.team_nickname_overrides.get(team_name, team_name) if league.team_nickname_overrides else team_name) | clean_team_name }}
{%- endmacro %}

{% macro wax_seal(css_class) %}
{% set monogram = league.seal_monogram if league.seal_monogram else (league.commissioner_name.split() | last)[0] | upper %}
<div class="wax-seal {{ css_class }}">
  <svg viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg">
    <circle cx="45" cy="45" r="42" fill="#6a1018" />
    <circle cx="45" cy="45" r="42" fill="none" stroke="#3d0a0f" stroke-width="2" />
    <circle cx="45" cy="45" r="34" fill="none" stroke="#c29a3b" stroke-width="1" stroke-dasharray="1.5,3" />
    <text x="45" y="57" text-anchor="middle" font-family="Cinzel, Georgia, serif" font-weight="700"
          font-size="{{ 36 if monogram|length <= 1 else 26 }}" letter-spacing="-1"
          fill="#ecdfba">{{ monogram }}</text>
  </svg>
</div>
{% endmacro %}

<div class="footer">
  {% if asset_exists(league.logo_path) %}<img src="{{ league.logo_path }}" alt="">{% endif %}
  <span>{{ league.league_name }} · Week {{ report.week }} · {{ report.season_year }}</span>
  {% if asset_exists("assets/espn_logo.png") %}<img src="assets/espn_logo.png" alt="ESPN">{% endif %}
  {% if asset_exists("assets/nfl_logo.png") %}<img src="assets/nfl_logo.png" alt="NFL">{% endif %}
</div>

<div class="cover">
  <img class="corner tl" src="assets/corner-flourish.svg" alt="">
  <img class="corner tr" src="assets/corner-flourish.svg" alt="">
  <img class="corner bl" src="assets/corner-flourish.svg" alt="">
  <img class="corner br" src="assets/corner-flourish.svg" alt="">
  {% if asset_exists(league.logo_path) %}<img class="logo" src="{{ league.logo_path }}" alt="">{% else %}{{ wax_seal("seal") }}{% endif %}
  <div class="eyebrow">Weekly Recap</div>
  <div class="league-name">{{ league.league_name }}</div>
  <div class="rule"></div>
  <div class="week-title">
    {% if report.is_season_finale %}Season Finale — Week {{ report.week }} Report
    {%- else %}Week {{ report.week }} Report{% endif %}
  </div>
  <div class="report-date">{{ report.report_date.strftime("%B %-d, %Y") }}</div>
</div>

<div class="section">
  <h2>Week {{ report.week }} Scoreboard</h2>
  {% for m in report.matchups %}
  <div class="matchup {{ 'home-winner' if m.winner_name == m.home_team_name else 'away-winner' }}">
    {# Five grid cells (name | score | vs | score | name) so both scores sit in fixed columns beside
       the "vs" and line up down the page regardless of team-name length. #}
    <div class="team {{ 'winner' if m.winner_name == m.home_team_name else '' }}">{{ display_name(m.home_team_name) }}</div>
    <div class="score home {{ 'winner' if m.winner_name == m.home_team_name else '' }}">{{ "%.2f"|format(m.home_score) }}</div>
    <div class="vs">vs</div>
    <div class="score away {{ 'winner' if m.winner_name == m.away_team_name else '' }}">{{ "%.2f"|format(m.away_score) }}</div>
    <div class="team {{ 'winner' if m.winner_name == m.away_team_name else '' }}">{{ display_name(m.away_team_name) }}</div>
  </div>
  {% endfor %}
</div>

<div class="section">
  <h2>Current Standings</h2>
  <table class="standings-table">
    <thead>
      <tr>
        <th>Team</th>
        <th>Record</th>
        <th>PF</th>
        <th>PA</th>
        <th>Streak</th>
        <th>Playoff %</th>
        <th>Power Rank</th>
        <th>Mike's Rankings<span class="sponsor-badge">Powered by Jersey Mike's</span></th>
      </tr>
    </thead>
    <tbody>
      {% set divisions = report.standings | map(attribute="division_name") | unique | list %}
      {% if divisions | length > 1 %}
        {% for division in divisions %}
        <tr class="division-header"><td colspan="8">{{ division }}</td></tr>
        {% for row in report.standings if row.division_name == division %}
        <tr>
          <td>{{ display_name(row.team_name) }}</td>
          <td>{{ row.wins }}-{{ row.losses }}{% if row.ties %}-{{ row.ties }}{% endif %}</td>
          <td>{{ "%.2f"|format(row.points_for) }}</td>
          <td>{{ "%.2f"|format(row.points_against) }}</td>
          <td>{{ row.streak }}</td>
          <td>{{ "%.1f%%"|format(row.playoff_pct) if row.playoff_pct is not none else "—" }}</td>
          <td>{{ row.power_rank if row.power_rank is not none else "—" }}</td>
          <td>{{ row.commissioner_rank if row.commissioner_rank is not none else "—" }}</td>
        </tr>
        {% endfor %}
        {% endfor %}
      {% else %}
        {% for row in report.standings %}
        <tr>
          <td>{{ display_name(row.team_name) }}</td>
          <td>{{ row.wins }}-{{ row.losses }}{% if row.ties %}-{{ row.ties }}{% endif %}</td>
          <td>{{ "%.2f"|format(row.points_for) }}</td>
          <td>{{ "%.2f"|format(row.points_against) }}</td>
          <td>{{ row.streak }}</td>
          <td>{{ "%.1f%%"|format(row.playoff_pct) if row.playoff_pct is not none else "—" }}</td>
          <td>{{ row.power_rank if row.power_rank is not none else "—" }}</td>
          <td>{{ row.commissioner_rank if row.commissioner_rank is not none else "—" }}</td>
        </tr>
        {% endfor %}
      {% endif %}
    </tbody>
  </table>
</div>

<div class="section highlights-tables">
  <h2>Week {{ report.week }} Team Highlights</h2>
  <table>
    <thead>
      <tr><th>Category</th><th>Team</th><th>Value</th></tr>
    </thead>
    <tbody>
      {% for label, stat in report.team_highlights.items() %}
      <tr>
        <td>{{ label }}</td>
        <td>{{ display_name(stat.team_name) }}</td>
        <td>
          {{ "%.2f"|format(stat.value) }}
          {% if stat.detail %}<div class="highlight-detail">{{ stat.detail }}</div>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Week {{ report.week }} Individual Highlights</h2>
  <table class="individual-table">
    <thead>
      <tr><th>Category</th><th>Player</th><th>Team</th><th>Performance</th></tr>
    </thead>
    <tbody>
      {% for label, stat in report.individual_highlights.items() %}
      {% set is_spotlight = label in ["Rookie Spotlight", "Gamecock of the Week"] %}
      <tr class="{{ 'spotlight-row' if is_spotlight else '' }}">
        <td>{% if is_spotlight %}<span class="spotlight-mark"></span>{% endif %}{{ label }}</td>
        <td>{{ stat.player_name }} <span class="highlight-detail">({{ stat.position }} — {{ stat.pro_team }})</span></td>
        <td>
          {% if stat.team_name %}{{ display_name(stat.team_name) }}{% else %}<span class="unrostered-tag">Free agent</span>{% endif %}
        </td>
        <td>{% if stat.detail %}{{ stat.detail }}{% else %}{{ "%.2f"|format(stat.points) }}{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="section letter">
  <h2>Raven From {{ league.commissioner_name }}</h2>
  <img class="divider-ornament" src="assets/divider-ornament.svg" alt="">
  <div class="letter-date">{{ report.report_date.strftime("%B %-d, %Y") }}</div>
  <div class="letter-body">
    {% for paragraph in (report.commissioners_letter or "").split("\n\n") %}
      {% if paragraph.strip() %}<p>{{ paragraph.strip() }}</p>{% endif %}
    {% endfor %}
  </div>
  <div class="signature-block">
    {{ wax_seal("seal") }}
    <div class="signature">{{ league.commissioner_name }}</div>
  </div>
</div>

{% if report.is_season_finale and report.season_extras %}
<div class="section">
  <h2>Season Highlights</h2>
  {# Season-finale-only blocks: PF trendlines, top players, All-Fantasy Team, Team MVPs,
     best single-week performances, season stats appendix. Populated once report_data.py
     grows a season-finale code path (build order item 5 in the design spec). #}
</div>
{% endif %}
