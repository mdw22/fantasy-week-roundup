# Copy this file to .env and fill in real values. .env is gitignored.

# Numeric ID from the league's ESPN URL
LEAGUE_ID=

# e.g. 2025
SEASON_YEAR=

# Cookie values pulled from browser dev tools while logged into ESPN Fantasy.
# Quote them — both can contain characters (%, +, =, {}) that upset shell/dotenv parsing otherwise.
ESPN_S2=
SWID=

# For Commissioner's Letter narrative generation
ANTHROPIC_API_KEY=
